# Copy to .env for local/VPS builds. Values below are the project's public
# (publishable) backend credentials — safe to commit; they are the same ones
# the hosted dashboard uses. Never put service-role keys or DB passwords here.

# --- Backend (Lovable Cloud / Supabase) --------------------------------------
# Client bundle (Vite) needs the VITE_ prefixed copies.
VITE_SUPABASE_URL="https://gifvvyibkymmpncglozf.supabase.co"
VITE_SUPABASE_PUBLISHABLE_KEY="sb_publishable_wmhQGuBqnEcwGXspf19FFA_hhshamYB"
VITE_SUPABASE_PROJECT_ID="gifvvyibkymmpncglozf"

# Server functions and the headless runner read the unprefixed copies.
SUPABASE_URL="https://gifvvyibkymmpncglozf.supabase.co"
SUPABASE_PUBLISHABLE_KEY="sb_publishable_wmhQGuBqnEcwGXspf19FFA_hhshamYB"
SUPABASE_PROJECT_ID="gifvvyibkymmpncglozf"

# --- Persistence -------------------------------------------------------------
# Neon and Supabase run SIMULTANEOUSLY:
#   * Neon (DATABASE_URL) = canonical LOGIN store (app_users) + live_trades.
#   * Supabase (above)    = the trade database (paper accounts, trades,
#                           signals, shadow book, heartbeat).
# Set DATABASE_URL to enable Neon login; leave DATA_STORE unset (default
# "supabase"). Use DATA_STORE=neon only to move trade data into Neon too.
DATABASE_URL=
DATA_STORE=supabase
# Optional: pins local auth tokens across restarts (derived from DATABASE_URL
# when empty).
LOCAL_AUTH_SECRET=

# --- Headless runner (docker compose / VPS) ----------------------------------
# The bot account's login — sign it up once on the app's auth screen. The
# dashboard must sign in as this SAME account to see the runner's trades.
RUNNER_EMAIL=
RUNNER_PASSWORD=

# Bybit venue: "testnet" (default) or "mainnet" (REAL funds).
BYBIT_ENV=testnet
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=
# Fallback / mainnet pair — only used when the testnet pair is empty.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# --- Health check (/api/public/health) ---------------------------------------
# Optional message-bus endpoints. Left empty they report "not configured"
# instead of failing the check.
# Upstash-style REST Redis (pingable from the edge runtime):
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Raw TCP Redis for the runner container (not verifiable from the edge):
REDIS_URL=
# NATS: NATS_URL is the client endpoint, NATS_MONITOR_URL its :8222 HTTP
# monitoring port (used for /healthz).
NATS_URL=
NATS_MONITOR_URL=
# Optional outbound alert (Slack/Discord-style JSON webhook) fired whenever a
# health probe comes back degraded or down.
HEALTH_ALERT_WEBHOOK=
