[Unit]
Description=Alpha Swarm headless paper-trading runner
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=alphaswarm
WorkingDirectory=/opt/alpha-swarm
ExecStart=/usr/bin/npx tsx runner/index.ts
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
