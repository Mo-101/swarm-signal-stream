# Copy to runner/.env and fill in. Never commit the real file.

# Neon is the canonical login and trade-data store.
DATABASE_URL=
DATA_STORE=neon
LOCAL_AUTH_SECRET=

# Optional legacy mirror only. Leave unset on the VPS.
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The bot account's login. Create this once via the app's auth screen (sign
# up with a dedicated email — don't reuse your personal login), then put its
# credentials here. The dashboard must sign in as this SAME account to see
# the runner's trades and flip into Observer mode.
RUNNER_EMAIL=
RUNNER_PASSWORD=

# Bybit venue: "testnet" (default) or "mainnet" (REAL funds).
BYBIT_ENV=testnet

# Testnet key pair from testnet.bybit.com (Account > API). These win over the
# plain BYBIT_API_* fallback below; mainnet keys 401 against the testnet host.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# Fallback / mainnet pair. Only used when the BYBIT_TESTNET_* vars are empty.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional message bus + health alerting (see root .env.example).
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NATS_URL=
NATS_MONITOR_URL=
HEALTH_ALERT_WEBHOOK=
