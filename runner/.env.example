# Copy to runner/.env and fill in. Never commit the real file.

# Neon and Supabase run side by side:
#   * Neon (DATABASE_URL) = canonical LOGIN store (app_users) + live_trades.
#   * Supabase            = the trade database (paper accounts, trades,
#                           signals, shadow book, runner state).
# Set DATABASE_URL so the runner can sign in against Neon. DATA_STORE stays
# "supabase" unless you deliberately want trade data inside Neon.
DATABASE_URL=
DATA_STORE=supabase
LOCAL_AUTH_SECRET=

# Same Supabase project the dashboard uses (see .env.example in the repo root
# for the current values). Primary persistence backend. REQUIRED.
SUPABASE_URL=https://gifvvyibkymmpncglozf.supabase.co
SUPABASE_PUBLISHABLE_KEY=sb_publishable_wmhQGuBqnEcwGXspf19FFA_hhshamYB

# The bot account's login. Create this once via the app's auth screen (sign
# up with a dedicated email — don't reuse your personal login), then put its
# credentials here. The dashboard must sign in as this SAME account to see
# the runner's trades and flip into Observer mode.
RUNNER_EMAIL=
RUNNER_PASSWORD=

# Bybit venue: "testnet" (default) or "mainnet" (REAL funds).
BYBIT_ENV=testnet

# Testnet key pair from testnet.bybit.com (Account > API). These win over the
# plain BYBIT_API_* fallback below; mainnet keys 401 against the testnet host.
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_SECRET=

# Fallback / mainnet pair. Only used when the BYBIT_TESTNET_* vars are empty.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Optional message bus + health alerting (see root .env.example).
REDIS_URL=
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
NATS_URL=
NATS_MONITOR_URL=
HEALTH_ALERT_WEBHOOK=
