# Copy to runner/.env and fill in. Never commit the real file.

# Same Supabase project the dashboard uses (see the app's own .env).
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# The bot account's login. Create this once via the app's auth screen (sign
# up with a dedicated email — don't reuse your personal login), then put its
# credentials here. The dashboard must sign in as this SAME account to see
# the runner's trades and flip into Observer mode.
RUNNER_EMAIL=
RUNNER_PASSWORD=
